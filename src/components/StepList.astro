---
type Step = {
  title: string
  text: string
}

type Props = {
  steps: Step[]
}

const { steps } = Astro.props
---

<ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="relative">
        <span
          class="text-navy-100 absolute -top-3 font-serif text-5xl font-light"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="border-gold-400 mt-5 border-t pt-6">
          <h3 class="text-navy-700 text-lg">{step.title}</h3>
          <p class="text-navy-600 mt-2 text-[14px] leading-relaxed">{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>
