---
import { getLangFromUrl, localizePath, routes, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const year = new Date().getFullYear()
---

<footer class="bg-navy-800 text-navy-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-3 lg:px-8">
    <div>
      <p class="font-serif text-2xl font-medium text-white">D2A Avocat</p>
      <p class="text-navy-200 mt-3 max-w-xs text-[14px]">{t('footer.tagline')}</p>
    </div>
    <div class="text-[14px] leading-relaxed">
      <p>{t('footer.address')}</p>
      <p class="mt-2">
        <a class="hover:text-gold-300" href={`mailto:${t('footer.email')}`}>
          {t('footer.email')}
        </a>
      </p>
    </div>
    <div class="flex flex-col gap-2 text-[13px] font-medium">
      <a class="hover:text-gold-300" href={localizePath(lang, routes.legal)}>
        {t('footer.legal')}
      </a>
      <a class="hover:text-gold-300" href={localizePath(lang, routes.privacy)}>
        {t('footer.privacy')}
      </a>
    </div>
  </div>
  <div class="border-navy-700 border-t">
    <p class="text-navy-300 mx-auto max-w-6xl px-5 py-5 text-[12px] lg:px-8">
      © {year} D2A Avocat. {t('footer.rights')}
    </p>
  </div>
</footer>
