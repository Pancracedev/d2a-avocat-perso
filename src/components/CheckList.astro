---
import Icon from './Icon.astro'

type Props = {
  items: string[]
}

const { items } = Astro.props
---

<ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
  {
    items.map((item) => (
      <li class="text-navy-700 flex items-start gap-3 text-[15px]">
        <Icon
          name="check"
          size={18}
          class="text-gold-500 mt-1 shrink-0"
          strokeWidth={2.2}
        />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
