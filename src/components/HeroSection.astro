---
import Button from './Button.astro'
import Reveal from './Reveal'
import { getLangFromUrl, routes, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section class="relative overflow-hidden bg-ink-50">
  <div class="wrap grid min-h-[680px] items-center gap-12 py-16 lg:grid-cols-[1.04fr_0.96fr] lg:gap-20 lg:py-24">
    <div class="relative z-10">
      <Reveal client:load>
        <p class="eyebrow">D2A Avocat · France · Afrique de l’Ouest</p>
      </Reveal>
      <Reveal client:load delay={0.08}>
        <h1 class="mt-6 max-w-3xl text-5xl sm:text-6xl lg:text-[76px]">Le droit qui vous ressemble</h1>
      </Reveal>
      <Reveal client:load delay={0.16}>
        <p class="mt-7 max-w-xl text-[17px] leading-8 text-ink-600 lg:text-lg">
          {t('hero.subtitle')}
        </p>
      </Reveal>
      <Reveal client:load delay={0.24}>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={routes.contact} lang={lang}>{t('hero.ctaPrimary')}</Button>
          <Button href={routes.expertise} lang={lang} variant="secondary">{t('hero.ctaSecondary')}</Button>
        </div>
      </Reveal>
      <Reveal client:load delay={0.32}>
        <div class="mt-14 grid max-w-xl grid-cols-3 border-t border-ink-200 pt-5">
          <div class="pr-4">
            <p class="font-serif text-3xl text-gold-500">03</p>
            <p class="mt-1 text-[12px] text-ink-600">domaines d’intervention</p>
          </div>
          <div class="border-l border-ink-200 px-4">
            <p class="font-serif text-3xl text-gold-500">03</p>
            <p class="mt-1 text-[12px] text-ink-600">pays accompagnés</p>
          </div>
          <div class="border-l border-ink-200 pl-4">
            <p class="font-serif text-3xl text-gold-500">48 h</p>
            <p class="mt-1 text-[12px] text-ink-600">pour un premier retour</p>
          </div>
        </div>
      </Reveal>
    </div>
    <Reveal client:load delay={0.12}>
      <figure class="relative mx-auto w-full max-w-[560px] lg:ml-auto">
        <div class="absolute -left-4 -top-4 h-24 w-24 border-l border-t border-gold-300 lg:-left-7 lg:-top-7" aria-hidden="true"></div>
        <div class="media-frame aspect-[4/5] shadow-2xl shadow-ink-900/20">
          <img src="/images/office-hero.jpeg" alt="Intérieur contemporain d’un espace de travail calme" loading="eager" fetchpriority="high" />
        </div>
        <figcaption class="mt-3 flex items-center justify-between text-[11px] uppercase tracking-[0.16em] text-ink-500">
          <span>Une pratique claire</span>
          <span class="text-gold-500">D2A / 01</span>
        </figcaption>
      </figure>
    </Reveal>
  </div>
</section>
