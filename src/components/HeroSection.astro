---
import Button from './Button.astro'
import Reveal from './Reveal'
import { getLangFromUrl, routes, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section class="bg-ink-50 relative overflow-hidden">
  <div
    class="wrap grid min-h-[680px] items-center gap-12 py-16 lg:grid-cols-[1.04fr_0.96fr] lg:gap-20 lg:py-24"
  >
    <div class="relative z-10">
      <Reveal client:load>
        <p class="eyebrow">D2A Avocat · France · Afrique de l’Ouest</p>
      </Reveal>
      <Reveal client:load delay={0.08}>
        <h1 class="mt-6 max-w-3xl text-5xl sm:text-6xl lg:text-[76px]">
          Le droit qui vous ressemble
        </h1>
      </Reveal>
      <Reveal client:load delay={0.16}>
        <p class="text-ink-600 mt-7 max-w-xl text-[17px] leading-8 lg:text-lg">
          {t('hero.subtitle')}
        </p>
      </Reveal>
      <Reveal client:load delay={0.24}>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={routes.contact} lang={lang}>{t('hero.ctaPrimary')}</Button>
          <Button href={routes.expertise} lang={lang} variant="secondary"
            >{t('hero.ctaSecondary')}</Button
          >
        </div>
      </Reveal>
      <Reveal client:load delay={0.32}>
        <div class="border-ink-200 mt-14 grid max-w-xl grid-cols-3 border-t pt-5">
          <div class="pr-4">
            <p class="text-gold-500 font-serif text-3xl">03</p>
            <p class="text-ink-600 mt-1 text-[12px]">domaines d’intervention</p>
          </div>
          <div class="border-ink-200 border-l px-4">
            <p class="text-gold-500 font-serif text-3xl">03</p>
            <p class="text-ink-600 mt-1 text-[12px]">pays accompagnés</p>
          </div>
          <div class="border-ink-200 border-l pl-4">
            <p class="text-gold-500 font-serif text-3xl">48 h</p>
            <p class="text-ink-600 mt-1 text-[12px]">pour un premier retour</p>
          </div>
        </div>
      </Reveal>
    </div>
    <Reveal client:load delay={0.12}>
      <figure class="relative mx-auto w-full max-w-[560px] lg:ml-auto">
        <div
          class="border-gold-300 absolute -top-4 -left-4 h-24 w-24 border-t border-l lg:-top-7 lg:-left-7"
          aria-hidden="true"
        >
        </div>
        <div class="media-frame shadow-ink-900/20 aspect-[4/5] shadow-2xl">
          <picture>
            <source srcset="/images/office-hero.webp" type="image/webp" />
            <img
              src="/images/office-hero.jpeg"
              alt="Intérieur contemporain d’un espace de travail calme"
              width="4500"
              height="3213"
              loading="eager"
              fetchpriority="high"
              sizes="(max-width: 1024px) 100vw, 50vw"
              decoding="async"
            />
          </picture>
        </div>
        <figcaption
          class="text-ink-500 mt-3 flex items-center justify-between text-[11px] tracking-[0.16em] uppercase"
        >
          <span>Une pratique claire</span>
          <span class="text-gold-500">D2A / 01</span>
        </figcaption>
      </figure>
    </Reveal>
  </div>
</section>
