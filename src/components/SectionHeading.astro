---
type Props = {
  eyebrow?: string
  title: string
  text?: string
  align?: 'left' | 'center'
}

const { eyebrow, title, text, align = 'left' } = Astro.props
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {
    eyebrow && (
      <p class="text-gold-500 text-[12px] font-medium tracking-[0.16em]">{eyebrow}</p>
    )
  }
  <h2 class="text-navy-700 mt-3 text-3xl sm:text-4xl">{title}</h2>
  {text && <p class="text-navy-600 mt-4 text-[16px]">{text}</p>}
</div>
