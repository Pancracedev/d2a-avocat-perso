---
import Button from './Button.astro'
import type { Lang } from '../i18n/ui'

type Props = {
  lang: Lang
  eyebrow?: string
  title: string
  text?: string
  primaryHref: string
  primaryLabel: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  lang,
  eyebrow,
  title,
  text,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props
---

<section class="bg-navy-900">
  <div class="wrap flex flex-col items-center py-20 text-center lg:py-24">
    {
      eyebrow && (
        <p class="text-gold-400 text-[12px] font-medium tracking-[0.16em]">{eyebrow}</p>
      )
    }
    <h2 class="mt-4 max-w-2xl text-3xl text-white sm:text-4xl">{title}</h2>
    {text && <p class="text-navy-100 mt-4 max-w-xl text-[16px]">{text}</p>}
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={primaryHref} lang={lang} variant="gold">
        {primaryLabel}
      </Button>
      {
        secondaryHref && secondaryLabel && (
          <Button href={secondaryHref} lang={lang} variant="outlineLight">
            {secondaryLabel}
          </Button>
        )
      }
    </div>
  </div>
</section>
