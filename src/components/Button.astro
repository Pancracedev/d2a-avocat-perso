---
import type { Lang } from '../i18n/ui'
import { localizePath } from '../i18n/utils'

type Props = {
  href: string
  lang: Lang
  variant?: 'primary' | 'secondary' | 'ghost'
  className?: string
}

const variants = {
  primary: 'bg-navy-600 text-white hover:bg-navy-700 focus-visible:outline-gold-400',
  secondary:
    'border border-navy-600 text-navy-700 hover:border-gold-400 hover:text-navy-800 focus-visible:outline-gold-400',
  ghost: 'text-navy-700 hover:text-gold-500 focus-visible:outline-gold-400',
}

const { href, lang, variant = 'primary', className = '' } = Astro.props
const resolved = localizePath(lang, href)
---

<a
  href={resolved}
  class:list={[
    'inline-flex items-center justify-center rounded-sm px-5 py-3 text-[13px] font-medium tracking-wide transition-colors duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
