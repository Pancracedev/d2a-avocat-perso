---
import Reveal from '../Reveal'
import SectionHeading from '../SectionHeading.astro'
import Icon from '../Icon.astro'
import type { UiKey } from '../../i18n/ui'
import { getLangFromUrl, localizePath, routes, useTranslations } from '../../i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const items = [
  {
    icon: 'briefcase' as const,
    title: t('home.guide.0.title' as UiKey),
    text: t('home.guide.0.text' as UiKey),
    href: routes.business,
  },
  {
    icon: 'globe' as const,
    title: t('home.guide.1.title' as UiKey),
    text: t('home.guide.1.text' as UiKey),
    href: routes.immigration,
  },
  {
    icon: 'home' as const,
    title: t('home.guide.2.title' as UiKey),
    text: t('home.guide.2.text' as UiKey),
    href: routes.family,
  },
]
---

<section class="bg-ink-50">
  <div class="wrap py-20 lg:py-24">
    <SectionHeading
      eyebrow={t('home.guide.eyebrow' as UiKey)}
      title={t('home.guide.title' as UiKey)}
      text={t('home.guide.text' as UiKey)}
    />
    <Reveal client:visible>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          items.map((item, index) => (
            <a
              href={localizePath(lang, item.href)}
              class="editorial-card group"
              aria-label={`${item.title} — ${t('expertises.card.cta')}`}
            >
              <div class="flex items-start justify-between gap-5">
                <span class="section-number group-hover:text-gold-200" aria-hidden="true">
                  0{index + 1}
                </span>
                <Icon
                  name={item.icon}
                  size={22}
                  class="text-navy-600 group-hover:text-gold-600 transition-colors"
                />
              </div>
              <h3 class="text-navy-800 mt-10 text-2xl">{item.title}</h3>
              <p class="text-ink-600 mt-3 text-[14px] leading-7">{item.text}</p>
              <span class="text-navy-800 mt-6 inline-flex items-center gap-2 text-[12px] font-semibold tracking-[0.12em] uppercase">
                {t('home.guide.cta' as UiKey)}
                <span
                  class="text-gold-500 transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </Reveal>
  </div>
</section>
