---
import Icon from './Icon.astro'
import type { Lang } from '../i18n/ui'
import { localizePath } from '../i18n/utils'

type IconName = 'briefcase' | 'globe' | 'home'

type Props = {
  lang: Lang
  icon: IconName
  index: string
  title: string
  text: string
  href: string
  ctaLabel: string
}

const { lang, icon, index, title, text, href, ctaLabel } = Astro.props
---

<a
  href={localizePath(lang, href)}
  class="card group hover:border-gold-300 hover:shadow-navy-100/60 flex flex-col p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
>
  <div class="flex items-start justify-between">
    <span class="text-navy-100 font-serif text-5xl font-light" aria-hidden="true">
      {index}
    </span>
    <span
      class="bg-navy-50 text-navy-700 group-hover:bg-gold-50 group-hover:text-gold-600 rounded-sm p-3 transition-colors duration-300"
    >
      <Icon name={icon} size={24} />
    </span>
  </div>
  <h3 class="text-navy-700 mt-8 text-xl">{title}</h3>
  <p class="text-navy-600 mt-3 grow text-[15px] leading-relaxed">{text}</p>
  <span class="text-navy-800 mt-6 inline-flex items-center gap-2 text-[13px] font-medium">
    {ctaLabel}
    <Icon
      name="arrow-right"
      size={16}
      class="text-gold-500 transition-transform duration-300 group-hover:translate-x-1"
    />
  </span>
</a>
