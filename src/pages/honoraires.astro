---
import PageLayout from '@/layouts/PageLayout.astro'
import Reveal from '@/components/Reveal'
import CtaBanner from '@/components/CtaBanner.astro'
import ConsultationCard from '@/components/ConsultationCard.astro'
import { getLangFromUrl, routes, useTranslations } from '@/i18n/utils'
import type { UiKey } from '@/i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const crumbs = [
  { href: routes.home, label: t('nav.home') },
  { href: routes.fees, label: t('nav.fees') },
]

const modes = [0, 1, 2].map((i) => ({
  title: t(`honor.modes.${i}.title` as UiKey),
  text: t(`honor.modes.${i}.text` as UiKey),
}))

const consult = [0, 1, 2, 3].map((i) => ({
  title: t(`home.consult.${i}.title` as UiKey),
  format: t(`home.consult.${i}.format` as UiKey),
  price: t(`home.consult.${i}.price` as UiKey),
  note: t(`home.consult.${i}.note` as UiKey),
}))
---

<PageLayout
  title={t('fees.title')}
  description={t('fees.description')}
  intro={t('fees.intro')}
  eyebrow={t('honor.eyebrow')}
  crumbs={crumbs}
>
  <Reveal client:visible>
    <section>
      <h2 class="text-navy-700 text-2xl">{t('honor.philosophy.title')}</h2>
      <div class="text-navy-600 mt-4 space-y-4 text-[15px] leading-relaxed">
        <p>{t('honor.philosophy.0')}</p>
        <p>{t('honor.philosophy.1')}</p>
      </div>
    </section>
  </Reveal>

  <Reveal client:visible delay={0.05}>
    <section class="mt-14">
      <h2 class="text-navy-700 text-2xl">{t('honor.modes.title')}</h2>
      <p class="text-navy-600 mt-3 max-w-2xl text-[15px]">{t('honor.modes.text')}</p>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {
          modes.map((mode) => (
            <article class="card flex flex-col p-6">
              <h3 class="text-navy-700 text-lg">{mode.title}</h3>
              <p class="text-navy-600 mt-2 grow text-[14px] leading-relaxed">
                {mode.text}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </Reveal>

  <Reveal client:visible delay={0.1}>
    <section class="mt-14">
      <h2 class="text-navy-700 text-2xl">{t('honor.grid.title')}</h2>
      <p class="text-navy-600 mt-3 max-w-2xl text-[15px]">{t('honor.grid.text')}</p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          consult.map((c, i) => (
            <ConsultationCard
              title={c.title}
              format={c.format}
              price={c.price}
              note={c.note}
              isHighlighted={c.price !== '[À confirmer]' && i === 2}
            />
          ))
        }
      </div>
      <p class="text-navy-500 mt-4 text-[12px]">{t('honor.grid.disclaimer')}</p>
    </section>
  </Reveal>

  <Reveal client:visible delay={0.15}>
    <section class="mt-14 grid gap-6 md:grid-cols-2">
      <article class="card p-6">
        <h2 class="text-navy-700 text-xl">{t('honor.payment.title')}</h2>
        <p class="text-navy-600 mt-3 text-[14px] leading-relaxed">
          {t('honor.payment.text')}
        </p>
      </article>
      <article class="card p-6">
        <h2 class="text-navy-700 text-xl">{t('honor.aj.title')}</h2>
        <p class="text-navy-600 mt-3 text-[14px] leading-relaxed">{t('honor.aj.text')}</p>
      </article>
    </section>
  </Reveal>

  <Reveal client:visible delay={0.2}>
    <div class="mt-16">
      <CtaBanner
        lang={lang}
        title={t('honor.cta.title')}
        text={t('honor.cta.text')}
        primaryHref={routes.contact}
        primaryLabel={t('honor.cta.primary')}
        secondaryHref={routes.contact}
        secondaryLabel={t('honor.cta.secondary')}
      />
    </div>
  </Reveal>
</PageLayout>
