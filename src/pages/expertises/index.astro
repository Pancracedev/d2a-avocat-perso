---
import ExpertiseCard from '@/components/ExpertiseCard.astro'
import Reveal from '@/components/Reveal'
import PageLayout from '@/layouts/PageLayout.astro'
import { getLangFromUrl, routes, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const areas = [
  {
    href: routes.business,
    icon: 'briefcase' as const,
    title: t('expertises.business'),
    text: t('expert.business.description'),
  },
  {
    href: routes.immigration,
    icon: 'globe' as const,
    title: t('expertises.immigration'),
    text: t('expert.immigration.description'),
  },
  {
    href: routes.family,
    icon: 'home' as const,
    title: t('expertises.family'),
    text: t('expert.family.description'),
  },
]
---

<PageLayout
  title={t('expertises.title')}
  description={t('expertises.description')}
  intro={t('expertises.intro')}
>
  <Reveal client:visible>
    <div class="grid gap-6 lg:grid-cols-3">
      {
        areas.map((area, index) => (
          <ExpertiseCard
            lang={lang}
            icon={area.icon}
            index={String(index + 1).padStart(2, '0')}
            title={area.title}
            text={area.text}
            href={area.href}
            ctaLabel={t('expertises.card.cta')}
          />
        ))
      }
    </div>
  </Reveal>
</PageLayout>
