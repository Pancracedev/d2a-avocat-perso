---
import PageLayout from '@/layouts/PageLayout.astro'
import Reveal from '@/components/Reveal'
import ArticleCard from '@/components/ArticleCard.astro'
import CtaBanner from '@/components/CtaBanner.astro'
import { getLangFromUrl, routes, useTranslations } from '@/i18n/utils'
import { getCollection } from 'astro:content'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const crumbs = [
  { href: routes.home, label: t('nav.home') },
  { href: routes.news, label: t('nav.news') },
]

const allPosts = await getCollection(
  'news',
  (entry) => entry.data.lang === lang && !entry.data.draft,
)
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const categories = ['all', 'business', 'immigration', 'family'] as const
type Filter = (typeof categories)[number]

function mapCategory(post: any): Filter {
  const c = post.data.category?.toLowerCase() ?? ''
  if (c.includes('affaire') || c.includes('business')) return 'business'
  if (c.includes('étranger') || c.includes('immig')) return 'immigration'
  if (c.includes('famille') || c.includes('family')) return 'family'
  return 'all'
}
---

<PageLayout
  title={t('news.title')}
  description={t('news.description')}
  intro={t('news.intro')}
  eyebrow={t('news.eyebrow')}
  crumbs={crumbs}
>
  <Reveal client:visible>
    <div class="card flex flex-wrap gap-2 p-2">
      {
        categories.map((cat) => (
          <button
            type="button"
            data-filter={cat}
            class="filter-btn data-[active=true]:bg-navy-700 rounded-sm px-3 py-1.5 text-[13px] font-medium transition-colors duration-200 data-[active=true]:text-white"
          >
            {t(`news.filter.${cat}` as any)}
          </button>
        ))
      }
    </div>
  </Reveal>

  <Reveal client:visible delay={0.05}>
    <div id="news-grid" class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        allPosts.map((post) => (
          <div class="news-item" data-category={mapCategory(post)}>
            <ArticleCard entry={post} lang={lang} label={t('news.read')} />
          </div>
        ))
      }
    </div>
    <p id="news-empty" class="text-navy-600 mt-6 hidden text-center text-[14px]">
      {t('news.empty')}
    </p>
  </Reveal>

  <Reveal client:visible delay={0.15}>
    <div class="mt-16">
      <CtaBanner
        lang={lang}
        title={t('news.cta.title')}
        text={t('news.cta.text')}
        primaryHref={routes.contact}
        primaryLabel={t('news.cta.primary')}
      />
    </div>
  </Reveal>

  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn')
    const items = document.querySelectorAll('.news-item')
    const empty = document.getElementById('news-empty')

    function setActive(filter) {
      buttons.forEach((b) => (b.dataset.active = String(b.dataset.filter === filter)))
      let visible = 0
      items.forEach((el) => {
        const cat = el.dataset.category
        const show = filter === 'all' || cat === filter
        el.classList.toggle('hidden', !show)
        if (show) visible++
      })
      if (empty) empty.classList.toggle('hidden', visible !== 0)
    }

    buttons.forEach((b) => b.addEventListener('click', () => setActive(b.dataset.filter)))
    setActive('all')
  </script>
</PageLayout>
