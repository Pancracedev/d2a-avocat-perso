---
import PageLayout from '@/layouts/PageLayout.astro'
import Reveal from '@/components/Reveal'
import CtaBanner from '@/components/CtaBanner.astro'
import Icon from '@/components/Icon.astro'
import { getLangFromUrl, routes, useTranslations } from '@/i18n/utils'
import { site } from '@/config/site'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const crumbs = [
  { href: routes.home, label: t('nav.home') },
  { href: routes.firm, label: t('nav.firm') },
]

const values = [0, 1, 2, 3].map((i) => ({
  icon: (['target', 'shield', 'heart', 'briefcase'] as const)[i],
  title: t(`cabinet.values.${i}.title` as any),
  text: t(`cabinet.values.${i}.text` as any),
}))
---

<PageLayout
  title={t('cabinet.title')}
  description={t('cabinet.description')}
  intro={t('cabinet.intro')}
  eyebrow={t('cabinet.eyebrow')}
  crumbs={crumbs}
>
  <div class="grid gap-12 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-16">
      <Reveal client:visible>
        <section class="border-ink-200/90 border-y py-10 lg:py-12">
          <blockquote class="border-gold-300 relative border-l-2 pl-6">
            <span
              class="text-gold-300 pointer-events-none absolute -top-4 -left-1 font-serif text-5xl leading-none select-none"
              aria-hidden="true"
            >
              “
            </span>
            <p class="text-navy-800 font-serif text-xl italic lg:text-2xl">
              {t('cabinet.quote')}
            </p>
          </blockquote>
          <h2 class="text-navy-700 mt-10 text-2xl">{t('cabinet.bio.title')}</h2>
          <p class="text-navy-600 mt-4 text-[15px] leading-relaxed whitespace-pre-line">
            {t('cabinet.bio.text')}
          </p>
        </section>
      </Reveal>

      <Reveal client:visible delay={0.1}>
        <section>
          <h2 class="text-navy-700 text-2xl">{t('cabinet.values.title')}</h2>
          <p class="text-navy-600 mt-3 max-w-xl text-[15px]">
            {t('cabinet.values.text')}
          </p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {
              values.map((value) => (
                <article class="card flex flex-col p-6">
                  <span class="bg-gold-50 text-gold-600 shadow-gold-900/5 flex h-10 w-10 items-center justify-center rounded-sm shadow-sm">
                    <Icon name={value.icon} size={20} />
                  </span>
                  <h3 class="text-navy-700 mt-5 text-lg">{value.title}</h3>
                  <p class="text-navy-600 mt-2 grow text-[14px] leading-relaxed">
                    {value.text}
                  </p>
                </article>
              ))
            }
          </div>
        </section>
      </Reveal>
    </div>

    <aside class="space-y-6">
      <Reveal client:visible>
        <div class="border-ink-200/90 border-t pt-6">
          <figure>
            <div
              class="portrait-placeholder aspect-[4/5]"
              role="img"
              aria-label={t('cabinet.photo.alt')}
            >
              <span class="brand-mark border-gold-300 text-gold-300 h-16 w-16 text-base"
                >D2A</span
              >
              <span class="mt-6 max-w-[14rem] text-center font-serif text-2xl text-white"
                >{t('cabinet.photo.pending')}</span
              >
              <span
                class="text-navy-200 mt-3 text-center text-[11px] tracking-[0.18em] uppercase"
                >Portrait de marque</span
              >
            </div>
            <figcaption class="text-navy-500 mt-3 text-[12px]">
              {t('cabinet.photo.alt')}
            </figcaption>
          </figure>
        </div>
      </Reveal>

      <Reveal client:visible delay={0.05}>
        <div class="border-ink-200/90 border-t pt-6">
          <h3 class="text-navy-700 text-lg">{t('cabinet.benin.title')}</h3>
          <p class="text-navy-600 mt-2 text-[14px] leading-relaxed">
            {t('cabinet.benin.text')}
          </p>
          <a
            href={site.partner.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-navy-800 decoration-gold-400 hover:text-navy-950 mt-4 inline-flex items-center gap-2 text-[13px] font-medium underline decoration-1 underline-offset-4"
          >
            {t('cabinet.benin.link')}
            <Icon name="arrow-right" size={16} class="text-gold-500" />
          </a>
        </div>
      </Reveal>
    </aside>
  </div>

  <Reveal client:visible delay={0.15}>
    <div class="mt-16">
      <CtaBanner
        lang={lang}
        title={t('cabinet.cta.title')}
        text={t('cabinet.cta.text')}
        primaryHref={routes.contact}
        primaryLabel={t('cabinet.cta.primary')}
      />
    </div>
  </Reveal>
</PageLayout>
