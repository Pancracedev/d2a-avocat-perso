---
import PageLayout from '@/layouts/PageLayout.astro'
import { getLangFromUrl, routes, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const crumbs = [
  { href: routes.home, label: t('nav.home') },
  { href: routes.legal, label: t('legal.title') },
]

const sections = [0, 1, 2, 3, 4, 5, 6].map((i) => ({
  title: t(`legal.s.${i}.title` as any),
  body: t(`legal.s.${i}.body` as any),
}))
---

<PageLayout
  title={t('legal.title')}
  description={t('legal.description')}
  intro={t('legal.intro')}
  eyebrow={t('legal.eyebrow')}
  crumbs={crumbs}
>
  <div class="max-w-3xl space-y-10">
    {
      sections.map((section, index) => (
        <section class="border-navy-100 border-t pt-8 first:border-t-0 first:pt-0">
          <h2 class="text-navy-700 flex items-baseline gap-3 text-xl">
            <span class="text-gold-500 font-serif text-[13px] font-medium">
              {String(index + 1).padStart(2, '0')}
            </span>
            {section.title}
          </h2>
          <div class="text-navy-600 mt-3 space-y-2 text-[15px] leading-relaxed">
            {section.body.split('\n').map((line) => (
              <p>{line}</p>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</PageLayout>
